@page "/weightclasses"
@inherits BasePage
@using VehicleCategoryManager.Client.DTOs
@using VehicleCategoryManager.Client.Components
@inject HttpClient Http

<PageTitle>Weight Classes</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Weight Classes:</h1>
    <button class="btn btn-primary" @onclick="OpenModal">
        Add Weight Class
    </button>
</div>
@if (weightClasses == null)
{
    <p>Loading Weight Classes...</p>
}
else if (!string.IsNullOrEmpty(loadErrorMessage))
{
    <p class="text-danger">@loadErrorMessage</p>
}
else if (weightClasses.Count == 0)
{
    <p>No weight classes found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(WeightClassDTO.VehicleWeightClassName))">
                        Name @SortIcon(nameof(WeightClassDTO.VehicleWeightClassName))
                    </button>
                </th>
                <th>Icon</th>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(WeightClassDTO.MinWeightKg))">
                        Min Weight (kg) @SortIcon(nameof(WeightClassDTO.MinWeightKg))
                    </button>
                </th>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(WeightClassDTO.MaxWeightKg))">
                        Max Weight (kg) @SortIcon(nameof(WeightClassDTO.MaxWeightKg))
                    </button>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var weightClass in SortedWeightClasses)
            {
                <tr>
                    <td>@weightClass.VehicleWeightClassName</td>
                    <td>
                        <img src="@weightClass.VehicleWeightClassIconPath" style="width:30px;" alt="Weight Icon" />
                    </td>
                    <td>@string.Format("{0}kg", weightClass.MinWeightKg)</td>
                    <td>
                        @(weightClass.MaxWeightKg != null
                            ? $"{weightClass.MaxWeightKg}kg"
                            : "No Limit")
                    </td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditWeightClass(weightClass.VehicleWeightClassId)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => PromptDelete(weightClass.VehicleWeightClassId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if(!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
}


<AddWeightClassModal @ref="weightclassModal" @bind-IsOpen="isModalOpen" OnWeightClassAdded="LoadWeightClasses" />
<DeleteConfirmationModal @ref="deleteModal" @bind-IsOpen="isDeletionModalOpen" OnConfirmed="DeleteWeightClass" />