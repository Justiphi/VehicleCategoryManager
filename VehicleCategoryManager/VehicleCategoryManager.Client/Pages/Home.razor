@page "/"
@using VehicleCategoryManager.Client.DTOs
@using VehicleCategoryManager.Client.Components
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Vehicles!</h1>
    <button class="btn btn-primary" @onclick="OpenModal">
        Add Vehicle
    </button>
</div>
@if (vehicles == null)
{
    <p>Loading vehicles...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
else if (vehicles.Count == 0)
{
    <p>No vehicles found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Owner</th>
                <th>Year</th>
                <th>Manufacturer</th>
                <th>Weight (kg)</th>
                <th>Weight Category</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehicle in vehicles)
            {
                <tr>
                    <td>@vehicle.Owner</td>
                    <td>@vehicle.Year</td>
                    <td>@vehicle.ManufacturerName</td>
                    <td>@vehicle.WeightKg</td>
                    <td>
                        <img src="@vehicle.WeightCategoryIconPath" style="width:30px;" alt="Weight Icon" />
                    </td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditVehicle(vehicle.VehicleId)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeleteVehicle(vehicle.VehicleId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


<AddVehicleModal @ref="vehicleModal" @bind-IsOpen="isModalOpen"
                 OnVehicleAdded="LoadVehicles" />


@code {

    private AddVehicleModal? vehicleModal { get; set; }

    List<VehicleDTO>? vehicles;
    private string? errorMessage; 
    private bool isModalOpen;

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        try
        {
            vehicles = await Http.GetFromJsonAsync<List<VehicleDTO>>("api/Vehicle") ?? new();
            errorMessage = null;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load vehicles.";
        }
    }

    private async Task DeleteVehicle(int vehicleId)
    {
        HttpResponseMessage response = await Http.DeleteAsync($"api/Vehicle/{vehicleId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadVehicles();
        }
        else
        {
            errorMessage = "Unable to delete vehicle.";
        }
    }

    private async Task EditVehicle(int vehicleId)
    {
        if (vehicles == null) return;
        vehicleModal?.Vehicle = vehicles.FirstOrDefault(v => v.VehicleId == vehicleId, new());
        OpenModal();
    }

    private void OpenModal() => isModalOpen = true;
}