@page "/"
@inherits BasePage
@using VehicleCategoryManager.Client.DTOs
@using VehicleCategoryManager.Client.Components
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Vehicles:</h1>
    <div>
        <button class="btn btn-primary" @onclick="LoadVehicles">
            Refresh
        </button>
        <button class="btn btn-primary" @onclick="OpenModal">
            Add Vehicle
        </button>
    </div>
</div>
@if (vehicles == null)
{
    <p>Loading vehicles...</p>
}
else if (!string.IsNullOrEmpty(loadErrorMessage))
{
    <p class="text-danger">@loadErrorMessage</p>
}
else if (vehicles.Count == 0)
{
    <p>No vehicles found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(VehicleDTO.Owner))">
                        Owner @SortIcon(nameof(VehicleDTO.Owner))
                    </button>
                </th>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(VehicleDTO.Year))">
                        Year @SortIcon(nameof(VehicleDTO.Year))
                    </button>
                </th>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(VehicleDTO.ManufacturerName))">
                        Manufacturer @SortIcon(nameof(VehicleDTO.ManufacturerName))
                    </button>
                </th>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(VehicleDTO.WeightKg))">
                        Weight (kg) @SortIcon(nameof(VehicleDTO.WeightKg))
                    </button>
                </th>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(VehicleDTO.WeightKg))">
                        Weight Category @SortIcon(nameof(VehicleDTO.WeightKg))
                    </button>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehicle in SortedVehicles)
            {
                <tr>
                    <td>@vehicle.Owner</td>
                    <td>@vehicle.Year</td>
                    <td>@vehicle.ManufacturerName</td>
                    <td>@vehicle.WeightKg</td>
                    <td>
                        <img src="@vehicle.WeightCategoryIconPath" style="width:30px;" alt="Weight Icon" />
                    </td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditVehicle(vehicle.VehicleId)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => PromptDelete(vehicle.VehicleId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if(!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
}


<AddVehicleModal @ref="vehicleModal" @bind-IsOpen="isModalOpen" OnVehicleAdded="LoadVehicles" />
<DeleteConfirmationModal @ref="deleteModal" @bind-IsOpen="isDeletionModalOpen" OnConfirmed="DeleteVehicle" />