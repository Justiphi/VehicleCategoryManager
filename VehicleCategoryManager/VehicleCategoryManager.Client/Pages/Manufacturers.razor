@page "/manufacturers"
@inherits BasePage
@using VehicleCategoryManager.Client.DTOs
@using VehicleCategoryManager.Client.Components
@inject HttpClient Http

<PageTitle>Manufacturers</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Manufacturers:</h1>
    <button class="btn btn-primary" @onclick="OpenModal">
        Add Manufacturer
    </button>
</div>
@if (manufacturers == null)
{
    <p>Loading Manufacturers...</p>
}
else if (!string.IsNullOrEmpty(loadErrorMessage))
{
    <p class="text-danger">@loadErrorMessage</p>
}
else if (manufacturers.Count == 0)
{
    <p>No manufacturers found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <button class="sort-header" @onclick="() => SortBy(nameof(ManufacturerDTO.ManufacturerName))">
                        Manufacturer Name @SortIcon(nameof(ManufacturerDTO.ManufacturerName))
                    </button>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var manufacturer in SortedManufacturers)
            {
                <tr>
                    <td>@manufacturer.ManufacturerName</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditManufacturer(manufacturer.ManufacturerId)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => PromptDelete(manufacturer.ManufacturerId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if(!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
}


<AddManufacturerModal @ref="manufacturerModal" @bind-IsOpen="isModalOpen" OnManufacturerAdded="LoadManufacturers" />
<DeleteConfirmationModal @ref="deleteModal" @bind-IsOpen="isDeletionModalOpen" OnConfirmed="DeleteManufacturer" />
